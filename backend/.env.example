# Animal Guardian 360° - Backend Environment Template
ENVIRONMENT=development
APP_NAME="Animal Guardian 360°"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="your-super-secure-jwt-secret-key-at-least-32-bytes"
FRONTEND_URL="http://localhost:3000"

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=animal_guardian_db
DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/animal_guardian_db"
TEST_DATABASE_URL="sqlite+aiosqlite:///./test.db"

# Redis Cache
REDIS_URL="redis://localhost:6379/0"

# Authentication & Security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3
MOCK_OTP_MODE=true

# External APIs (Optional in dev)
GOOGLE_MAPS_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Storage (AWS S3 / Cloudflare R2)
S3_ENDPOINT_URL=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="animal-guardian-media"
S3_PUBLIC_DOMAIN=""

# Communications (SendGrid / SMS)
EMAIL_PROVIDER="mock"
FROM_EMAIL="support@animalguardian360.org"
FROM_NAME="Animal Guardian 360°"
SENDGRID_API_KEY=""
SMS_PROVIDER="mock"
SMS_API_KEY=""

# Observability
SENTRY_DSN=""

