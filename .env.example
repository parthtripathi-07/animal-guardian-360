# Animal Guardian 360° - Environment Configuration Template

# -------------------------------------------------------------
# General Application Settings
# -------------------------------------------------------------
ENVIRONMENT=development
APP_NAME="Animal Guardian 360°"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
FRONTEND_URL="http://localhost:3000"

# -------------------------------------------------------------
# Database (PostgreSQL with PostGIS and pgvector)
# -------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=animal_guardian_db
# Async connection URL
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/animal_guardian_db"
# Fallback / Test database (SQLite for local rapid tests)
TEST_DATABASE_URL="sqlite+aiosqlite:///./test.db"

# -------------------------------------------------------------
# Redis (Caching & Rate Limiting)
# -------------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"

# -------------------------------------------------------------
# JWT Authentication & Security
# -------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3
# When true, OTP codes are logged to console instead of sending SMS/email
MOCK_OTP_MODE=true

# -------------------------------------------------------------
# External APIs & Integrations (Required for Production)
# -------------------------------------------------------------
# Google Maps (Places, Geocoding, Maps JS API)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key-here"

# Razorpay (Payments & UPI)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Object Storage (Cloudflare R2 / AWS S3)
S3_ENDPOINT_URL="https://your-account-id.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your_s3_access_key"
S3_SECRET_ACCESS_KEY="your_s3_secret_key"
S3_BUCKET_NAME="animal-guardian-media"
S3_PUBLIC_DOMAIN="https://media.animalguardian360.org"

# Email Delivery (SendGrid or AWS SES)
EMAIL_PROVIDER="mock" # "sendgrid", "ses", or "mock"
SENDGRID_API_KEY="your_sendgrid_api_key"
FROM_EMAIL="support@animalguardian360.org"
FROM_NAME="Animal Guardian 360°"

# SMS Delivery (Twilio / Fast2SMS / MSG91)
SMS_PROVIDER="mock" # "msg91", "twilio", or "mock"
SMS_API_KEY="your_sms_api_key"

# AI Embeddings
AI_MODEL_NAME="open_clip:ViT-B-32"
EMBEDDING_DEVICE="cpu" # "cpu" or "cuda"
